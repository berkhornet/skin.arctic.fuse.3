{
    "for_each": [
        {
            "datafile": "generator/data/infoline/items.json",
            "for_each": [
                {
                    "template": "<variable name=\"InfoLine_Units_{dbtype}_{item}\"><value condition=\"{enabled}\">{tokens}</value></variable>",
                    "condition": "{dbtype}>>{types}",
                    "tokens": {
                        "datafile": "generator/data/infoline/units.json",
                        "for_each": [
                            {
                                "template": "{object}={disable}||",
                                "condition": "$MATH[{cost} - {unit}]!<-"
                            }
                        ]
                    },
                    "datafile": "generator/data/infoline/state.json"
                }
            ]
        },
        {
            "template": "<variable name=\"InfoLine_Units_{dbtype}\"><value>{global_units}{local_units}</value></variable>",
            "global_units": {
                "datafile": "generator/data/infoline/items.json",
                "for_each": [
                    {
                        "template": "$VAR[InfoLine_Units_{dbtype}_{item}]",
                        "condition": [
                            "{dbtype}>>{types}",
                            "{global_flag}!="
                        ]
                    }
                ]
            },
            "local_units": {
                "datafile": "generator/data/infoline/items.json",
                "for_each": [
                    {
                        "template": "$VAR[InfoLine_Units_{dbtype}_{item}]",
                        "condition": [
                            "{dbtype}>>{types}",
                            "{global_flag}=="
                        ]
                    }
                ]
            }
        },
        {
            "template": "<include name=\"InfoLine_Count_{dbtype}\"><item><label>1</label><onclick>noop</onclick></item>{units}</include>",
            "units": {
                "datafile": "generator/data/infoline/items.json",
                "for_each": [
                    {
                        "template": "{units}",
                        "condition": "{dbtype}>>{types}",
                        "units": {
                            "datafile": "generator/data/infoline/units.json",
                            "for_each": [
                                {
                                    "template": "<item><label>{unit}</label><visible>{enabled}</visible><onclick>noop</onclick></item>",
                                    "condition": "$MATH[{cost} - {unit}]!<-"
                                }
                            ]
                        },
                        "datafile": "generator/data/infoline/state.json"
                    }
                ]
            }
        },
        {
            "template": "<include name=\"InfoLine_Rows_{dbtype}\">{rows}</include>",
            "rows": {
                "datafile": "generator/data/infoline/items.json",
                "for_each": [
                    {
                        "list": [
                            [
                                "enabled",
                                {
                                    "disabled": "false"
                                }
                            ],
                            [
                                "disabled",
                                {
                                    "disabled": "true"
                                }
                            ]
                        ],
                        "for_each": [
                            {
                                "datafile": [
                                    "generator/data/infoline/state.json",
                                    "generator/data/infoline/row.json"
                                ]
                            }
                        ]
                    }
                ]
            }
        }
    ]
}
