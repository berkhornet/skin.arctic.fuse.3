{
    "for_each": [
        {
            "condition": "{global_flag}!=",
            "template": "<variable name=\"InfoLine_Units_Global_{item}\"><value>{layouts}</value></variable>",
            "layouts": {
                "datafile": "generator/data/infoline/types.json",
                "for_each": [
                    {
                        "condition": "{dbtype}>>{types}",
                        "template": "/$VAR[InfoLine_Units_{dbtype}]"
                    }
                ]
            }
        }
    ]
}
