	<expression name="FHNatho_Standard_Channel">[Integer.IsGreaterOrEqual(ListItem.ChannelNumberLabel,201) + Integer.IsLessOrEqual(ListItem.ChannelNumberLabel,400)]</expression>
	<expression name="FHNatho_Football_Channel">[Integer.IsGreaterOrEqual(ListItem.ChannelNumberLabel,701) + Integer.IsLessOrEqual(ListItem.ChannelNumberLabel,800)]</expression>
	<expression name="FHNatho_Channel">$EXP[FHNatho_Standard_Channel] | $EXP[FHNatho_Football_Channel]</expression>
    
    <variable name="TextPVRProviderName">
        <value condition="$EXP[FHNatho_Channel]">FHNATHO</value>
        <value condition="$EXP[Anova_Channel]">ANOVA</value>
        <value>UNKNOWN</value>
    </variable>


