     	<value condition="$EXP[FHD50FPS_Channel]">special://userdata/customisations\PVR\resolution flags\fhd50fps.png</value>
		<value condition="$EXP[FHD_Channel]">special://userdata/customisations\PVR\resolution flags\fhd.png</value>
